{
  "name": "orca-cloudflare-control-plane",
  "version": "1.0.4",
  "description": "Chemistry Lab Cloudflare Control Plane (Workers + D1)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply orca-control-plane-db --remote",
    "d1:migrate:local": "wrangler d1 migrations apply orca-control-plane-db --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "orca",
    "cloudflare-workers",
    "d1",
    "control-plane"
  ],
  "author": "Chemistry Lab Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
