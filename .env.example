# Flask session signing key. Set a long random value in Hugging Face Space Secrets.
SECRET_KEY=replace-with-a-long-random-secret

# Optional shared persistent state directory. /data is preferred on a
# Hugging Face Space with persistent storage; otherwise the app falls back to
# a writable project-local .state directory.
ORCA_STATE_DIR=/data

# Optional: Google Identity Services client id.
GOOGLE_CLIENT_ID=

# ORCA/Kaggle orchestration budgets can be overridden here when running outside
# Hugging Face. Keep the defaults unless you have measured a different quota.
# ORCA_TIME_LIMIT_SECONDS=39600
# ORCA_HANDOFF_RESERVE_SECONDS=1500
# ORCA_MAX_EPOCHS=24
# ORCA_MAX_TOTAL_OPT_CYCLES=1500
