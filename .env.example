# ORCA Web Lab Environment Configuration Template
FLASK_ENV=production
FLASK_SECRET_KEY=dev_secret_key_change_in_production
HOST=0.0.0.0
PORT=7860

# Cloudflare D1 Control Plane Configuration (Optional)
CONTROL_PLANE_URL=https://orca-control-plane.your-subdomain.workers.dev
CONTROL_PLANE_API_TOKEN=your_control_plane_token_here
CONTROL_PLANE_D1_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Kaggle API Credentials (Provided per-user in browser session or via environment)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here
KAGGLE_CREDENTIALS_ENCRYPTION_KEY=your_fernet_256bit_encryption_key_here
