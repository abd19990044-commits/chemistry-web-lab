# Copy to .env for development, or configure hosting environment variables.
# Generate each secret independently: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
KAGGLE_CREDENTIALS_ENCRYPTION_KEY=
# Set a Kaggle execution passcode for an internet-facing deployment.
KAGGLE_EXECUTION_PASSCODE=

# Stable directory shared by web and local-worker processes (Docker uses /data).
CHEMISTRY_LAB_STATE_DIR=.state
ORCA_RESULTS_DIR=.state/results
WEB_WORKERS=1
# Local startup embeds the ORCA worker; Docker sets the external-worker flag.
CHEMISTRY_LAB_BACKGROUND_ENABLED=1
CHEMISTRY_LAB_EMBEDDED_LOCAL_WORKER=1
CHEMISTRY_LAB_WORKFLOW_POLL_SECONDS=30

# Require authenticated execution on an internet-facing deployment.
CHEMISTRY_LAB_REQUIRE_AUTH=1
# Configure Google sign-in and the HTTPS browser origin.
GOOGLE_CLIENT_ID=
CHEMISTRY_LAB_ALLOWED_ORIGINS=https://your-deployment.example

# Optional Cloudflare control plane; leave disabled until configured.
CONTROL_PLANE_URL=
CONTROL_PLANE_API_TOKEN=
CONTROL_PLANE_PROJECT_ID=orca-web-lab
CONTROL_PLANE_NAMESPACE=production
