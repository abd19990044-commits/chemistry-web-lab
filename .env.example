# Chemistry Lab Environment Configuration Template
FLASK_ENV=production
SECRET_KEY=change_this_to_a_long_random_secret
HOST=0.0.0.0
PORT=7860

# Required in production for stateless Kaggle -> site callback authentication.
# Use a random secret >= 32 bytes and store it only in deployment secrets.
ORCA_CALLBACK_SECRET=replace_with_at_least_32_random_bytes

# Kaggle credentials are supplied per user and kept in RAM on the site.
# The private Kaggle runner carries its own credential only so it can launch
# self-continuation windows; Cloudflare/D1 is not part of the ORCA runtime.
KAGGLE_USERNAME=optional_local_development_username
KAGGLE_KEY=optional_local_development_key
